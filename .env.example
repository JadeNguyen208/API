# Sao chép thành .env hoặc chạy setup_keys.bat. Không commit file .env thật.
GEMINI_API_KEY=
SERPER_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Tùy chọn nếu broker dùng tên mã vàng/path MT5 khác.
XM_SYMBOL=GOLD
XM_MT5_PATH=

# Tùy chọn: thêm origin được phép gọi bridge, phân tách bằng dấu phẩy.
# XM_ALLOWED_ORIGINS=https://example.github.io
